# ===================== 应用基础 =====================
APP_ENV=development
APP_NAME=power-insight-agent
APP_DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ===================== MySQL =====================
# 宿主机端口 3307（docker-compose 避让映射，容器内为 3306）
# 异步驱动 asyncmy（SQLAlchemy 2.0 async 模式）；同步场景可换 mysql+pymysql
MYSQL_DSN=mysql+asyncmy://power:power@localhost:3307/power_insight
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_ECHO=false

# ===================== Redis =====================
# 宿主机端口 6380（docker-compose 避让映射，容器内为 6379）
REDIS_URL=redis://localhost:6380/0
REDIS_KEY_PREFIX=power

# ===================== Milvus =====================
MILVUS_URI=http://localhost:19530
MILVUS_DB=default
MILVUS_COLLECTION_PREFIX=power_

# ===================== Kafka =====================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=power-insight-agent

# ===================== LLM =====================
# 兼容 OpenAI 协议的服务商（deepseek / openai / qwen 等）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ===================== 安全 / JWT =====================
# 生产环境必须通过环境变量注入强随机密钥，禁止使用默认值
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===================== 租户与权限 =====================
ENABLE_MULTI_TENANT=false
DEFAULT_TENANT=default

# ===================== Agent 预算与超时 =====================
AGENT_MAX_STEPS=20
AGENT_BUDGET_TOKENS=50000
AGENT_BUDGET_USD=2.0
AGENT_TIMEOUT_SECONDS=300
AGENT_RETRY_MAX=3

# ===================== 幂等 / 限流 =====================
IDEMPOTENCY_TTL_SECONDS=86400
RATE_LIMIT_PER_MINUTE=120

# ===================== 可观测性 =====================
TRACING_ENABLED=false
METRICS_ENABLED=true
